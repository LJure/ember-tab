{
    "name": "aura-tab",
    "version": "3.5.3",
    "description": "A beautiful new tab extension",
    "type": "module",
    "scripts": {
        "build:firefox": "node tools/build-firefox.mjs",
        "lint:firefox": "web-ext lint --source-dir dist/firefox --output json",
        "test:firefox": "node tools/test-firefox.mjs",
        "test:firefox-build": "node --test tools/build-firefox.test.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "lint": "eslint scripts/ background-worker.js tools/",
        "lint:fix": "eslint scripts/ background-worker.js tools/ --fix"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "eslint": "^10.7.0",
        "geckodriver": "7.0.0",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "selenium-webdriver": "4.49.0",
        "vitest": "^4.1.10",
        "web-ext": "10.7.0"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
